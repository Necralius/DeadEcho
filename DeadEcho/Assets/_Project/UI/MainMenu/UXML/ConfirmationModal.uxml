<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="confirmation-modal" class="modal-overlay">
        <ui:VisualElement name="confirmation-dialog" class="modal-dialog">
            <ui:Label name="confirmation-title" class="modal-title" />
            <ui:Label name="confirmation-message" class="modal-message" />
            <ui:VisualElement name="confirmation-actions" class="modal-actions">
                <ui:Button name="cancel-button" text="Cancel" />
                <ui:Button name="confirm-button" text="Confirm" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
