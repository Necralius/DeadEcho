.ui-screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    flex-grow: 1;
    padding-left: 48px;
    padding-right: 48px;
    padding-top: 40px;
    padding-bottom: 40px;
    background-color: rgba(8, 10, 12, 0.92);
}

.screen-title {
    font-size: 42px;
    color: rgb(232, 236, 232);
    margin-bottom: 24px;
}

.screen-placeholder {
    color: rgb(170, 178, 176);
    margin-bottom: 16px;
}

.modal-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.55);
}

.modal-dialog {
    width: 460px;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 20px;
    padding-bottom: 20px;
    background-color: rgb(18, 21, 23);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(86, 96, 98);
    border-right-color: rgb(86, 96, 98);
    border-top-color: rgb(86, 96, 98);
    border-bottom-color: rgb(86, 96, 98);
}

.modal-title {
    font-size: 24px;
    color: rgb(232, 236, 232);
    margin-bottom: 12px;
}

.modal-message {
    color: rgb(190, 198, 196);
    white-space: normal;
    margin-bottom: 20px;
}

.modal-actions {
    flex-direction: row;
    justify-content: flex-end;
}

.controls-scroll,
.graphics-scroll {
    flex-grow: 1;
    min-height: 0;
    margin-bottom: 10px;
}

.controls-grid,
.graphics-grid {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: stretch;
}

.graphics-setting-card {
    width: 46%;
    min-width: 260px;
    min-height: 86px;
    margin-right: 14px;
    margin-bottom: 14px;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 14px;
    padding-bottom: 14px;
    justify-content: center;
    background-color: rgba(12, 15, 16, 0.96);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(55, 66, 63);
    border-right-color: rgb(55, 66, 63);
    border-top-color: rgb(55, 66, 63);
    border-bottom-color: rgb(55, 66, 63);
}

.settings-compact-actions {
    margin-top: 8px;
}

.settings-action-button {
    min-width: 132px;
    max-width: 190px;
}

.ui-dropdown,
.ui-integer-field,
.graphics-toggle {
    width: 100%;
    color: rgb(220, 225, 218);
}

.ui-dropdown .unity-base-field__label,
.ui-integer-field .unity-base-field__label,
.graphics-toggle .unity-toggle__label {
    color: rgb(220, 225, 218);
    font-size: 14px;
    margin-bottom: 8px;
}

.ui-dropdown .unity-base-popup-field__input,
.ui-dropdown .unity-popup-field__input,
.ui-integer-field .unity-text-input {
    min-height: 34px;
    padding-left: 10px;
    padding-right: 10px;
    color: rgb(238, 241, 232);
    background-color: rgb(19, 24, 25);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(78, 91, 87);
    border-right-color: rgb(78, 91, 87);
    border-top-color: rgb(78, 91, 87);
    border-bottom-color: rgb(78, 91, 87);
}

.ui-dropdown .unity-base-popup-field__text,
.ui-dropdown .unity-popup-field__text {
    color: rgb(238, 241, 232);
}

.ui-dropdown:focus .unity-base-popup-field__input,
.ui-dropdown:hover .unity-base-popup-field__input,
.ui-dropdown:focus .unity-popup-field__input,
.ui-dropdown:hover .unity-popup-field__input,
.ui-integer-field:focus .unity-text-input,
.ui-integer-field:hover .unity-text-input {
    background-color: rgb(27, 33, 34);
    border-left-color: rgb(176, 58, 63);
    border-right-color: rgb(176, 58, 63);
    border-top-color: rgb(176, 58, 63);
    border-bottom-color: rgb(176, 58, 63);
}

.binding-row {
    width: 48%;
    min-width: 300px;
    min-height: 112px;
    margin-right: 12px;
    margin-bottom: 12px;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 14px;
    padding-bottom: 14px;
    flex-direction: column;
    justify-content: space-between;
    background-color: rgba(15, 18, 19, 0.92);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(64, 74, 70);
    border-right-color: rgb(64, 74, 70);
    border-top-color: rgb(64, 74, 70);
    border-bottom-color: rgb(64, 74, 70);
}

.binding-text {
    flex-grow: 1;
    min-height: 0;
}

.binding-action {
    color: rgb(236, 238, 229);
    -unity-font-style: bold;
    white-space: normal;
    margin-bottom: 6px;
}

.binding-path {
    color: rgb(174, 181, 174);
    white-space: normal;
    margin-bottom: 10px;
}

.binding-rebind {
    min-width: 128px;
    align-self: flex-start;
}
